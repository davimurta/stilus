{
  "name": "stilus",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Stilus CLI: finds the editable texts of a Next.js site and syncs them.",
  "type": "module",
  "bin": {
    "stilus": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@stilus/shared": "workspace:*",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
