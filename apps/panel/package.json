{
  "name": "panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port ${PORT:-3200}",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "admin": "tsx --env-file-if-exists=.env src/admin/cli.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@davimurta/stilus-shared": "workspace:*",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15"
  }
}
