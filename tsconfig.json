{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Root files (configs, e2e) run through tsx/Playwright, which resolve like a bundler.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["e2e", "*.ts"]
}
