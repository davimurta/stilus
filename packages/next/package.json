{
  "name": "@davimurta/stilus-next",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./loader": {
      "types": "./dist/client/loader-entry.d.ts",
      "default": "./dist/client/loader-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@davimurta/stilus-shared": "workspace:*",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "description": "Stilus SDK for Next.js: editable texts with ISR and an inline editor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davimurta/stilus.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9"
  }
}
