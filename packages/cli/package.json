{
  "name": "@davimurta/stilus",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Stilus CLI: init, scan and sync the editable texts of a Next.js site.",
  "type": "module",
  "bin": {
    "stilus": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@davimurta/stilus-shared": "workspace:*",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davimurta/stilus.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9"
  }
}
